{
    "name": "Biweekly Stock Data Sync",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "triggerAtHour": 3,
                            "triggerAtMinute": 0,
                            "triggerAtDayOfMonth": 1
                        },
                        {
                            "triggerAtHour": 3,
                            "triggerAtMinute": 0,
                            "triggerAtDayOfMonth": 15
                        }
                    ]
                }
            },
            "id": "biweekly-cron",
            "name": "Biweekly Trigger (1st & 15th, 8:30 AM IST)",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                250,
                300
            ],
            "notes": "Runs on 1st and 15th of every month at 03:00 UTC = 08:30 IST.\nSources: trendlyne + go_india_stocks (Selenium-based, slow).\nUpdates: target_price_high/low, consensus_target_price, revenue/ebitda/pat/eps estimates for FY26E-FY28E."
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://72.61.226.16:5001/webhook/biweekly",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "X-API-Secret",
                            "value": "change-me-in-production"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "{\n  \"async\": true\n}",
                "options": {
                    "timeout": 30000
                }
            },
            "id": "biweekly-http",
            "name": "Trigger Biweekly Sync",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                480,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "conditions": [
                        {
                            "id": "condition-started",
                            "leftValue": "={{ $json.status }}",
                            "rightValue": "started",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "id": "biweekly-check",
            "name": "Job Started?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                700,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Wait 180 seconds before polling (Selenium scrapers are slow)\nawait new Promise(r => setTimeout(r, 180000));\n\nconst jobId = $('Trigger Biweekly Sync').first().json.job_id;\nconst resp = await this.helpers.httpRequest({\n  method: 'GET',\n  url: `http://72.61.226.16:5001/job/${jobId}`,\n  returnFullResponse: false,\n});\n\nreturn [{ json: resp }];"
            },
            "id": "biweekly-poll",
            "name": "Poll Job Status",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                920,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "conditions": [
                        {
                            "id": "condition-running",
                            "leftValue": "={{ $json.status }}",
                            "rightValue": "running",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "id": "biweekly-still-running",
            "name": "Still Running?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                1140,
                300
            ]
        },
        {
            "parameters": {
                "values": {
                    "string": [
                        {
                            "name": "message",
                            "value": "✅ Biweekly sync completed successfully!\nJob ID: {{ $json.job_id }}\nResult: {{ JSON.stringify($json.result) }}"
                        }
                    ]
                }
            },
            "id": "biweekly-success",
            "name": "✅ Success",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                1360,
                200
            ]
        },
        {
            "parameters": {
                "values": {
                    "string": [
                        {
                            "name": "message",
                            "value": "❌ Biweekly sync failed!\nStatus: {{ $json.status }}\nError: {{ $json.error || 'Unknown error' }}"
                        }
                    ]
                }
            },
            "id": "biweekly-error",
            "name": "❌ Error",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                920,
                500
            ]
        }
    ],
    "connections": {
        "Biweekly Trigger (1st & 15th, 8:30 AM IST)": {
            "main": [
                [
                    {
                        "node": "Trigger Biweekly Sync",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Trigger Biweekly Sync": {
            "main": [
                [
                    {
                        "node": "Job Started?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Job Started?": {
            "main": [
                [
                    {
                        "node": "Poll Job Status",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "❌ Error",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Poll Job Status": {
            "main": [
                [
                    {
                        "node": "Still Running?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Still Running?": {
            "main": [
                [
                    {
                        "node": "Poll Job Status",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "✅ Success",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    },
    "tags": [
        {
            "name": "stock-data"
        },
        {
            "name": "biweekly"
        }
    ]
}