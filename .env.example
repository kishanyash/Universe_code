# ─── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ─── Trendlyne Credentials ──────────────────────────────────────
TRENDLYNE_USERNAME=your-trendlyne-email
TRENDLYNE_PASSWORD=your-trendlyne-password

# ─── Screener.in Credentials ────────────────────────────────────
SCREENER_USERNAME=your-screener-email
SCREENER_PASSWORD=your-screener-password

# ─── Flask API ───────────────────────────────────────────────────
API_PORT=5001
API_SECRET=change-me-in-production
